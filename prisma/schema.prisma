generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  password      String?
  role          Role      @default(VIEWER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  pageVersions  PageVersion[] @relation("PageVersionAuthor")
  mediaAssets   MediaAsset[] @relation("MediaUploader")
  auditEvents   AuditEvent[] @relation("AuditActor")
  passwordResetTokens PasswordResetToken[]
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
}

enum Role {
  OWNER
  EDITOR
  VIEWER
}

model Lead {
  id              String   @id @default(cuid())
  name            String
  email           String
  company         String
  website         String?
  serviceRequested String
  challenge       String
  timeline        String
  budget          String?
  leadSource      String?
  consentAt       DateTime
  status          LeadStatus @default(NEW)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum LeadStatus {
  NEW
  QUALIFIED
  DISCOVERY_SCHEDULED
  PROPOSAL_SENT
  WON
  LOST
}

model Service {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  shortDescription String
  fullDescription  String
  targetAudience   String
  problemsSolved   String[]
  deliverables     String[]
  engagementProcess String[]
  ctaText          String
  price            String?
  metaTitle        String?
  metaDescription  String?
  createdAt        DateTime @default(now())
  isPublished      Boolean  @default(true)
  updatedAt       DateTime @updatedAt
}

model BlogPost {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  excerpt         String
  content         String
  category        String
  featuredImage   String?
  status          PostStatus @default(DRAFT)
  publishedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  versions        BlogPostVersion[]
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model BlogPostVersion {
  id         String   @id @default(cuid())
  blogPostId String
  blogPost   BlogPost @relation(fields: [blogPostId], references: [id], onDelete: Cascade)
  version    Int
  title      String
  excerpt    String
  content    String
  category   String
  createdAt  DateTime @default(now())

  @@unique([blogPostId, version])
}

model Page {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  content         Json
  metaTitle       String?
  metaDescription String?
  status          ContentStatus @default(DRAFT)
  publishedAt     DateTime?
  scheduledAt     DateTime?
  isPublished      Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt       DateTime @updatedAt
  versions         PageVersion[]
}

enum ContentStatus {
  DRAFT
  IN_REVIEW
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

model PageVersion {
  id              String   @id @default(cuid())
  pageId          String
  page            Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  version         Int
  title           String
  content         Json
  metaTitle       String?
  metaDescription String?
  createdById     String?
  createdBy       User?    @relation("PageVersionAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())

  @@unique([pageId, version])
  @@index([pageId, createdAt])
}

model MediaAsset {
  id           String   @id @default(cuid())
  url          String
  storageKey   String   @unique
  filename     String
  altText      String
  mimeType     String
  size         Int
  uploadedById String?
  uploadedBy   User?    @relation("MediaUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

model AuditEvent {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  target    String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([target])
}
